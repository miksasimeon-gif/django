from django.shortcuts import redirect


def auth_middleware(view_func):
    """
    Decorator-style middleware to ensure a customer is authenticated.

    When applied to a view, it checks whether ``customer`` is present in the
    session. If not, the user is redirected to the login page. Otherwise the
    original view is executed.

    Usage:
        from .middlewares.auth import auth_middleware
        urlpatterns = [
            path('orders', auth_middleware(OrderView.as_view()), name='orders'),
        ]
    """
    def wrapper(request, *args, **kwargs):
        if not request.session.get('customer'):
            return redirect('store:login')
        return view_func(request, *args, **kwargs)
    return wrapper
